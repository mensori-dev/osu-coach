# Скопируй в .env и заполни. Оба поля необязательны: без них приложение
# работает на локальных данных, а ключи можно вставить прямо в настройках.
#
# Где взять: https://osu.ppy.sh/home/account/edit#oauth
# Callback URL может быть любым, например http://localhost

OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Ник по умолчанию (можно поменять в настройках приложения)
OSU_USER=
